msgid "₿ Open in wallet"
msgstr "₿ Åpne i lommebok"

#: crates/rolid-ui/src/app/menu.rs:1042
msgid "🔎 Address on mempool.space"
msgstr "🔎 Adressen på mempool.space"

#: crates/rolid-ui/src/app/menu.rs:1046
msgid "Scan the QR code with a mobile wallet."
msgstr "Skann QR-koden med en mobillommebok."

