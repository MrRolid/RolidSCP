msgid "Cannot create a file in search results: open a folder first."
msgstr "Kan ikke opprette en fil i søkeresultater: åpne en mappe først."

#: crates/rolid-ui/src/app/newfile_ui.rs:56
msgid "Cannot create a file in an archive"
msgstr "Kan ikke opprette en fil i et arkiv"

