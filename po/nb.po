#: crates/rolid-ui/src/pane/inline.rs:60
msgid "The panel is not connected to the server."
msgstr "Panelet er ikke tilkoblet serveren."

#: crates/rolid-ui/src/app/newfile_ui.rs:75
msgid "New file"
msgstr "Ny fil"

#: crates/rolid-ui/src/app/newfile_ui.rs:76
msgid "The file is opened in the external editor (as with F4)."
msgstr "Filen åpnes i det eksterne redigeringsprogrammet (som med F4)."

#: crates/rolid-ui/src/app/newfile_ui.rs:93
#: crates/rolid-ui/src/app/newfile_ui.rs:120
#: crates/rolid-ui/src/app/newfile_ui.rs:142
msgid "A folder of this name already exists."
msgstr "En mappe med dette navnet finnes allerede."

#: crates/rolid-ui/src/app/newfile_ui.rs:94
msgid "A file of this name already exists: it will be opened for editing."
msgstr "En fil med dette navnet finnes allerede: den åpnes for redigering."

#: crates/rolid-ui/src/app/newfile_ui.rs:98
#: crates/rolid-ui/src/app/viewer/mod.rs:485
msgid "Edit"
msgstr "Rediger"

#: crates/rolid-ui/src/app/newfile_ui.rs:98
